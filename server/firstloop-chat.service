[Unit]
Description=First Loop chat service (relay to the Anthropic API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=firstloop-chat
Group=firstloop-chat
EnvironmentFile=/etc/firstloop-chat.env
ExecStart=/usr/bin/python3 /opt/firstloop-chat/firstloop-chat.py
Restart=on-failure
RestartSec=3

# The only places it may write: /var/log/firstloop-chat (its log) and
# /var/lib/firstloop-chat (today's counter, and the database of invite codes
# and usage counts). systemd creates both, owned by the service's user, and
# everything else on the disk is read-only to it. The installer puts the
# scrambled owner token in the second one, as a root-owned file the service
# can only read.
LogsDirectory=firstloop-chat
LogsDirectoryMode=0750
StateDirectory=firstloop-chat
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=200M
TasksMax=64

[Install]
WantedBy=multi-user.target

# firstloop-chat: end of file
